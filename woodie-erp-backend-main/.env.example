# Server (Render sets PORT automatically)
PORT=5000
NODE_ENV=development

# MongoDB — required on Render (add in Dashboard → Environment, not .env file)
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/woodie_erp
# Atlas example (URL-encode special characters in password):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/woodie_erp?retryWrites=true&w=majority

# Auth — required on Render
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated frontend URLs for CORS (add your Vercel/Netlify URL on production)
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
